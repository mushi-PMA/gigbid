# Copy to .env and fill in. Never commit .env. Every variable GigBid reads is listed here.

# --- app and secrets (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
APP_ENV=development
APP_SECRET_KEY=
MCP_SHARED_SECRET=
# Fernet key for OAuth tokens at rest: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
POSTGRES_PASSWORD=gigbid

# --- reviewer login preloaded with a persona (share the values privately, never in the repo)
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
REVIEWER_PERSONA=ai_ml_engineer

# --- marketplace
MARKETPLACE_MODE=gigsim              # gigsim | upwork_live
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_ERROR_RATE=0.02
GIGSIM_ADMIN_TOKEN=
GIGSIM_LLM=on
UPWORK_REDIRECT_URI=http://localhost:8000/api/integrations/upwork/callback

# --- models (profiles in agent/config.yaml: open = hosted open-weight pool, open_gemma = second open config,
# open_local = Ollama). Set any of the endpoint keys; the pool uses every one that is set.
MODEL_PROFILE=open
GROQ_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GEMINI_API_KEY=
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
GIGBID_LLM_CACHE=                    # folder for a disk cache of model calls (evaluation reruns)

# --- local development without Docker
DATABASE_URL=postgresql+psycopg://gigbid:gigbid@localhost:5432/gigbid
REDIS_URL=redis://localhost:6379/0
PORTFOLIO_MCP_URL=http://localhost:8101/mcp
MARKETPLACE_MCP_URL=http://localhost:8102/mcp
WORKSPACE_MCP_URL=http://localhost:8103/mcp
MCP_AUTH=on

# --- tracing (Arize Phoenix, self-hosted)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PUBLIC_URL=http://localhost:6006

# --- public URLs (deployment)
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- GitHub MCP server (third-party, repo ingestion); fine-grained token with read-only Contents
GITHUB_PERSONAL_ACCESS_TOKEN=
